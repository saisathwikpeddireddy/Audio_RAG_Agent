# Set these in your Vercel project (Settings -> Environment Variables),
# or copy to .env.local for local `next dev`.

# --- Required API keys ---
GROQ_API_KEY=
PINECONE_API_KEY=
GEMINI_API_KEY=

# --- Vercel Blob (auto-added when you connect a Blob store in Vercel) ---
BLOB_READ_WRITE_TOKEN=

# --- Optional overrides (sane defaults exist) ---
PINECONE_INDEX_NAME=audio-rag
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# editor: "gemini" (default) or "groq" fallback
EDITOR_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
GROQ_LLM_MODEL=llama-3.3-70b-versatile

TOP_K=5
PARENT_MAX_SECONDS=30
PAUSE_THRESHOLD_SECONDS=0.7
CROSSFADE_MS=50
