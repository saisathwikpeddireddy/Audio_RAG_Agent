# ---- Required API keys ----
GROQ_API_KEY=your_groq_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Vercel Blob ----
# Auto-injected when you connect a Blob store in the Vercel dashboard. Only needed
# for local dev outside Vercel.
BLOB_READ_WRITE_TOKEN=

# ---- Pinecone ----
PINECONE_INDEX_NAME=audio-rag
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Pinecone-hosted (integrated) embedding model — no OpenAI cost, free Starter tier.
PINECONE_EMBED_MODEL=llama-text-embed-v2

# ---- Transcription (Groq Whisper, word-level timestamps) ----
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---- Answer LLM ----
# gemini -> Google AI Studio (default). groq -> reuse the Groq key with a Llama
# model. Gemini automatically falls back to Groq on quota/availability errors.
EDITOR_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ---- Retrieval ----
# How many sentence chunks to retrieve per query (one card each).
TOP_K=5
