# ---- Required API keys ----
GROQ_API_KEY=your_groq_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: only used if EMBED_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# ---- Pinecone config ----
PINECONE_INDEX_NAME=audio-rag
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Embeddings ----
# pinecone  -> Pinecone-hosted embedding (no extra cost, free Starter plan)
# openai    -> OpenAI text-embedding-3-small (requires paid OpenAI account)
EMBED_PROVIDER=pinecone
PINECONE_EMBED_MODEL=llama-text-embed-v2
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Transcription (Groq) ----
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---- Editor LLM ----
# gemini -> Google AI Studio (default)
# groq   -> reuse Groq key with a Llama model (fallback)
EDITOR_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ---- Pipeline tuning ----
TOP_K=5
PARENT_MAX_SECONDS=30
PAUSE_THRESHOLD_SECONDS=0.7
CROSSFADE_MS=50
INPUT_DIR=data/input
OUTPUT_PATH=highlight_reel.mp3
